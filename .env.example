DASHSCOPE_API_KEY=replace_with_your_beijing_api_key
QWEN_MODEL=qwen3-omni-flash
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Keep qwen until nanoMuse desktop and its glasses bridge are configured.
# See docs/nanoMuse接入.md. Set nanomuse to route AI tasks through the desktop.
AI_BACKEND=qwen
NANOMUSE_BRIDGE_URL=http://127.0.0.1:18765
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Cherry
